{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/vercel-build.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/admin.js": {
      "includeFiles": "{.server/**,server/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin?action=panel" },
    { "source": "/admin/", "destination": "/api/admin?action=panel" }
  ],
  "redirects": [
    { "source": "/panel-sentot-2026.html", "destination": "/admin", "permanent": false }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/src/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
